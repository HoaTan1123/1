local ESP_SETTINGS = {
    Enabled = false,
    ShowBox = true,
    ShowName = false,
    ShowHealth = true,
    ShowDistance = false,
    ShowTracer = true,
    ShowSkeleton = true,
    ShowHighlight = true,
    TeamCheck = false,
    WallCheck = false,
    TeamColor = false,
    BoxColor = Color3.fromRGB(255, 0, 0),
    NameColor = Color3.fromRGB(255, 255, 255),
    TracerColor = Color3.fromRGB(255, 0, 0),
    TracerThickness = 1,
    TracerPosition = "Bottom",
    HealthBarWidth = 8,
    SkeletonColor = Color3.fromRGB(255, 255, 255)
}

local ShowSelfHealth = false
local ShowAttackTrail = false
local UnlockFOVEnabled = false
local ArrowEnabled = false
local ArrowMaxDistance = 500
local ArrowSize = 25
local ArrowColor = Color3.fromRGB(255, 0, 0)
local ArrowThickness = 2
local ArrowOpacity = 0.5
local FriendESPEnabled = true
local FriendTeamColor = Color3.fromRGB(0, 100, 255)
local FriendEnemyColor = Color3.fromRGB(255, 165, 0)

local Arrows = {}
local ArrowUpdateConnection = nil
local TeleportEnabled = false
local TeleportUI = nil
local TeleportUILocked = false
local TeleportUIOriginalPosition = UDim2.new(0.4, 0, 0.5, 0)
local JumpEnabled = false
local JumpUILocked = false
local JumpUI = nil
local JumpButtonOriginalPosition = UDim2.new(0.4, 0, 0.3, 0)
local buttonBindEnabled = false
local InteractUI = nil
local buttonUILocked = false
local buttonUIOriginalPosition = UDim2.new(0.5, 0, 0.6, 0)
