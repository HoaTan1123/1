    local spiderEnabled = false
    local SpiderUI = nil
    local spiderUILocked = false
    local spiderUIOriginalPosition = UDim2.new(0.7, 0, 0.3, 0)
    
    local Mode = 'Velocity'
    local Value = 30
    local State = true
    local rayCheck = RaycastParams.new()
    rayCheck.RespectCanCollide = true
    local Active, Truss
    local spiderConnection = nil
    
    ESPTab:CreateToggle({
        Name = "爬墙UI",
        CurrentValue = false,
        Callback = function(v)
            spiderEnabled = v
            if v then
                local ScreenGui = Instance.new("ScreenGui")
                local SpiderButton = Instance.new("TextButton")

                ScreenGui.Parent = game.CoreGui

                SpiderButton.Name = "SpiderButton"
                SpiderButton.Parent = ScreenGui
                SpiderButton.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
                SpiderButton.Position = spiderUIOriginalPosition
                SpiderButton.Size = UDim2.new(0, 100, 0, 40)
                SpiderButton.Font = Enum.Font.SourceSans
                SpiderButton.Text = "SPIDER"
                SpiderButton.TextColor3 = Color3.fromRGB(255, 255, 255)
                SpiderButton.TextSize = 30.000
                SpiderButton.Active = true
                
                if not spiderUILocked then
                    SpiderButton.Draggable = true
                end

                SpiderButton.BorderSizePixel = 2
                SpiderButton.BorderColor3 = Color3.fromRGB(255, 255, 255)
                local UICorner = Instance.new("UICorner")
                UICorner.CornerRadius = UDim.new(0, 8)
                UICorner.Parent = SpiderButton

                local function startSpider()
                    if spiderConnection then return end
                    
                    SpiderButton.Text = "ON"
                    SpiderButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
                    
                    spiderConnection = game:GetService("RunService").PreSimulation:Connect(function(dt)
                        local character = LocalPlayer.Character
                        if character and character:FindFirstChildOfClass("Humanoid") and character:FindFirstChildOfClass("Humanoid").Health > 0 then
                            local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
                            local humanoid = character:FindFirstChildOfClass("Humanoid")
                            
                            if root and humanoid then
                                local chars = {character}
                                if Truss then
                                    table.insert(chars, Truss)
                                end
                                
                                local SpiderShift = game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.LeftShift)
                                rayCheck.FilterDescendantsInstances = chars
                                rayCheck.CollisionGroup = root.CollisionGroup or "Default"

                                if Mode ~= 'Part' then
                                    local vec = humanoid.MoveDirection * 2.5
                                    local ray = workspace:Raycast(root.Position - Vector3.new(0, humanoid.HipHeight - 0.5, 0), vec, rayCheck)
                                    
                                    if Active and not ray then
                                        root.Velocity = Vector3.new(root.Velocity.X, 0, root.Velocity.Z)
                                    end

                                    Active = ray
                                    if Active and ray.Normal.Y == 0 then
                                        if not SpiderShift then
                                            if State then
                                                humanoid:ChangeState(Enum.HumanoidStateType.Climbing)
                                            end

                                            root.Velocity *= Vector3.new(1, 0, 1)
                                            root.Velocity += Vector3.new(0, Value, 0)
                                        end
                                    end
                                end
                            end
                        end
                    end)
                end

                local function stopSpider()
                    if spiderConnection then
                        spiderConnection:Disconnect()
                        spiderConnection = nil
                    end
                    
                    SpiderButton.Text = "SPIDER"
                    SpiderButton.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
                    
                    if Truss then
                        Truss:Destroy()
                        Truss = nil
                    end
                end

                SpiderButton.MouseButton1Down:connect(function()
                    if spiderConnection then
                        stopSpider()
                    else
                        startSpider()
                    end
                end)
                
                SpiderUI = ScreenGui
            else
                if SpiderUI then
                    SpiderUI:Destroy()
                    SpiderUI = nil
                end
                if spiderConnection then
                    spiderConnection:Disconnect()
                    spiderConnection = nil
                end
            end
        end
    })
    
    ESPTab:CreateToggle({
        Name = "爬墙UI锁定",
        CurrentValue = false,
        Callback = function(v)
            spiderUILocked = v
            if SpiderUI and SpiderUI:FindFirstChild("SpiderButton") then
                SpiderUI.SpiderButton.Draggable = not v
            end
        end
    })
    
    ESPTab:CreateButton({
        Name = "重置爬墙UI位置",
        Callback = function()
            if SpiderUI and SpiderUI:FindFirstChild("SpiderButton") then
                SpiderUI.SpiderButton.Position = spiderUIOriginalPosition
            end
        end
    })
    
