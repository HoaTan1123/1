function CreateTeleportUI()
    if TeleportUI then TeleportUI:Destroy() end
    
    local ScreenGui = Instance.new("ScreenGui")
    local TeleportButton = Instance.new("TextButton")
    
    ScreenGui.Parent = game.CoreGui
    
    TeleportButton.Name = "TeleportButton"
    TeleportButton.Parent = ScreenGui
    TeleportButton.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
    TeleportButton.Position = TeleportUIOriginalPosition
    TeleportButton.Size = UDim2.new(0, 120, 0, 40)
    TeleportButton.Font = Enum.Font.SourceSans
    TeleportButton.Text = "传送: 关闭"
    TeleportButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    TeleportButton.TextSize = 20
    TeleportButton.Active = true
    
    if not TeleportUILocked then
        TeleportButton.Draggable = true
    end
    
    TeleportButton.BorderSizePixel = 2
    TeleportButton.BorderColor3 = Color3.fromRGB(255, 255, 255)
    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 8)
    UICorner.Parent = TeleportButton
    
    local mouse = LocalPlayer:GetMouse()
    
    TeleportButton.MouseButton1Click:Connect(function()
        TeleportEnabled = not TeleportEnabled
        
        if TeleportEnabled then
            TeleportButton.Text = "传送: 开启"
            TeleportButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        else
            TeleportButton.Text = "传送: 关闭"
            TeleportButton.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
        end
    end)
    
    mouse.Button1Down:Connect(function()
        if TeleportEnabled and mouse.Target then
            local target = mouse.Hit.Position + Vector3.new(0, 3, 0)
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(target)
            end
        end
    end)
    
    TeleportUI = ScreenGui
end

function DestroyTeleportUI()
    if TeleportUI then
        TeleportUI:Destroy()
        TeleportUI = nil
    end
    TeleportEnabled = false
end

function CreateArrow(player)
    if player == LocalPlayer then return end
    
    if Arrows[player] then
        for _, drawing in pairs(Arrows[player]) do
            if drawing then drawing:Remove() end
        end
        Arrows[player] = nil
    end
    
    local arrow = {}
    
    arrow.MainTriangle = Drawing.new("Triangle")
    arrow.OutlineTriangle = Drawing.new("Triangle")
    arrow.Line = Drawing.new("Line")
    arrow.DistanceText = Drawing.new("Text")
    
    arrow.MainTriangle.Visible = false
    arrow.MainTriangle.Thickness = 1
    arrow.MainTriangle.Filled = true
    arrow.MainTriangle.Transparency = 1 - ArrowOpacity
    
    arrow.OutlineTriangle.Visible = false
    arrow.OutlineTriangle.Thickness = ArrowThickness
    arrow.OutlineTriangle.Filled = false
    arrow.OutlineTriangle.Color = Color3.new(0, 0, 0)
    arrow.OutlineTriangle.Transparency = 1 - ArrowOpacity
    
    arrow.Line.Visible = false
    arrow.Line.Thickness = ArrowThickness
    arrow.Line.Transparency = 1 - ArrowOpacity
    
    arrow.DistanceText.Visible = false
    arrow.DistanceText.Size = 16
    arrow.DistanceText.Center = true
    arrow.DistanceText.Outline = true
    arrow.DistanceText.OutlineColor = Color3.new(0, 0, 0)
    
    Arrows[player] = arrow
    return arrow
end

function UpdateArrow(player)
    local arrow = Arrows[player]
    if not arrow or not player.Character then return end
    
    local isTeammate = IsTeammate(player)
    if isTeammate and not ESP_SETTINGS.TeamCheck then
        arrow.MainTriangle.Visible = false
        arrow.OutlineTriangle.Visible = false
        arrow.Line.Visible = false
        arrow.DistanceText.Visible = false
        return
    end
    
    local humanoidRootPart = player.Character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local playerPos = humanoidRootPart.Position
    local screenPos, onScreen = Camera:WorldToViewportPoint(playerPos)
    
    if onScreen then
        arrow.MainTriangle.Visible = false
        arrow.OutlineTriangle.Visible = false
        arrow.Line.Visible = false
        arrow.DistanceText.Visible = false
        return
    end
    
    local distance = 0
    if LocalPlayer.Character then
        local localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if localRoot then
            distance = (playerPos - localRoot.Position).Magnitude
        end
    end
    
    if distance > ArrowMaxDistance then
        arrow.MainTriangle.Visible = false
        arrow.OutlineTriangle.Visible = false
        arrow.Line.Visible = false
        arrow.DistanceText.Visible = false
        return
    end
    
    local relativePos = Camera.CFrame:PointToObjectSpace(playerPos)
    local angle = math.atan2(relativePos.Z, relativePos.X)
    
    local viewportSize = Camera.ViewportSize
    local centerX = viewportSize.X / 2
    local centerY = viewportSize.Y / 2
    local radius = math.min(viewportSize.X, viewportSize.Y) * 0.35
    
    local edgeX = centerX + math.cos(angle) * radius
    local edgeY = centerY + math.sin(angle) * radius
    
    local padding = ArrowSize * 1.5
    edgeX = math.clamp(edgeX, padding, viewportSize.X - padding)
    edgeY = math.clamp(edgeY, padding, viewportSize.Y - padding)
    
    local rotation = math.deg(angle) + 90
    
    local size = ArrowSize
    local radAngle = math.rad(rotation - 90)
    
    local tipX = edgeX + math.cos(radAngle) * size
    local tipY = edgeY + math.sin(radAngle) * size
    
    local leftX = edgeX + math.cos(radAngle + 2.4) * (size * 0.6)
    local leftY = edgeY + math.sin(radAngle + 2.4) * (size * 0.6)
    
    local rightX = edgeX + math.cos(radAngle - 2.4) * (size * 0.6)
    local rightY = edgeY + math.sin(radAngle - 2.4) * (size * 0.6)
    
    arrow.MainTriangle.PointA = Vector2.new(tipX, tipY)
    arrow.MainTriangle.PointB = Vector2.new(leftX, leftY)
    arrow.MainTriangle.PointC = Vector2.new(rightX, rightY)
    
    arrow.OutlineTriangle.PointA = Vector2.new(tipX, tipY)
    arrow.OutlineTriangle.PointB = Vector2.new(leftX, leftY)
    arrow.OutlineTriangle.PointC = Vector2.new(rightX, rightY)
    
    local lineEndX = edgeX - math.cos(radAngle) * (size * 0.4)
    local lineEndY = edgeY - math.sin(radAngle) * (size * 0.4)
    
    arrow.Line.From = Vector2.new(edgeX, edgeY)
    arrow.Line.To = Vector2.new(lineEndX, lineEndY)
    
    local arrowColor = GetPlayerColor(player)
    arrow.MainTriangle.Color = arrowColor
    arrow.Line.Color = arrowColor
    
    if distance <= 200 then
        local textX = edgeX
        local textY = edgeY + size * 1.2
        
        arrow.DistanceText.Position = Vector2.new(textX, textY)
        arrow.DistanceText.Text = tostring(math.floor(distance)) .. "m"
        
        local ratio = distance / 200
        local r, g, b
        
        if ratio >= 0.67 then
            r = 255
            g = 255
            b = 255
        elseif ratio >= 0.33 then
            local t = (ratio - 0.33) / 0.34
            r = 255
            g = 255
            b = 255 * (1 - t)
        else
            local t = ratio / 0.33
            r = 255
            g = 255 * t
            b = 0
        end
        
        arrow.DistanceText.Color = Color3.fromRGB(r, g, b)
        arrow.DistanceText.Visible = true
    else
        arrow.DistanceText.Visible = false
    end
    
    arrow.MainTriangle.Visible = true
    arrow.OutlineTriangle.Visible = true
    arrow.Line.Visible = true
end

function RemoveArrow(player)
    if Arrows[player] then
        for _, drawing in pairs(Arrows[player]) do
            if drawing then drawing:Remove() end
        end
        Arrows[player] = nil
    end
end

function StartArrowSystem()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            CreateArrow(player)
        end
    end
    
    Players.PlayerAdded:Connect(function(player)
        CreateArrow(player)
    end)
    
    Players.PlayerRemoving:Connect(function(player)
        RemoveArrow(player)
    end)
    
    if ArrowUpdateConnection then
        ArrowUpdateConnection:Disconnect()
    end
    
    ArrowUpdateConnection = RunService.RenderStepped:Connect(function()
        if not ArrowEnabled then
            for _, arrow in pairs(Arrows) do
                if arrow.MainTriangle then arrow.MainTriangle.Visible = false end
                if arrow.OutlineTriangle then arrow.OutlineTriangle.Visible = false end
                if arrow.Line then arrow.Line.Visible = false end
                if arrow.DistanceText then arrow.DistanceText.Visible = false end
            end
            return
        end
        
        for player, arrow in pairs(Arrows) do
            if player and player.Parent and player.Character and player ~= LocalPlayer then
                UpdateArrow(player)
            else
                if arrow.MainTriangle then arrow.MainTriangle.Visible = false end
                if arrow.OutlineTriangle then arrow.OutlineTriangle.Visible = false end
                if arrow.Line then arrow.Line.Visible = false end
                if arrow.DistanceText then arrow.DistanceText.Visible = false end
            end
        end
    end)
end

function StopArrowSystem()
    if ArrowUpdateConnection then
        ArrowUpdateConnection:Disconnect()
        ArrowUpdateConnection = nil
    end
    
    for player in pairs(Arrows) do
        RemoveArrow(player)
    end
    
    Arrows = {}
end

local function createTrail(origin, targetPos)
    local part = Instance.new("Part") 
    part.Size = Vector3.new(0.2, 0.2, 0.2)
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = 1
    part.CFrame = CFrame.new(origin)
    part.Parent = workspace 

    local att0 = Instance.new("Attachment", part)
    local att1 = Instance.new("Attachment", workspace.Terrain)
    att1.WorldPosition = targetPos

    local beam = Instance.new("Beam", part)
    beam.Attachment0 = att0 
    beam.Attachment1 = att1 
    beam.Color = ColorSequence.new(Color3.fromRGB(0, 170, 255))
    beam.Width0 = 0.3
    beam.Width1 = 0.3
    beam.FaceCamera = true 
    beam.LightEmission = 1

    DebrisService:AddItem(part, 0.2)
end

local lastHealth = {}
game:GetService("Players").LocalPlayer.CharacterAdded:Connect(function(char)
    local humanoid = char:WaitForChild("Humanoid")
    lastHealth[LocalPlayer] = humanoid.Health
    humanoid.HealthChanged:Connect(function(health)
        if ShowAttackTrail and lastHealth[LocalPlayer] and health < lastHealth[LocalPlayer] then
            local damage = lastHealth[LocalPlayer] - health
            local origin = char:FindFirstChild("HumanoidRootPart").Position
            local targetPos
            for _, player in pairs(game:GetService("Players"):GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    targetPos = player.Character.HumanoidRootPart.Position
                    createTrail(origin, targetPos)
                end
            end
        end
        lastHealth[LocalPlayer] = health
    end)
end)

RunService.RenderStepped:Connect(function(deltaTime)
    SelfHealthText.Visible = ShowSelfHealth
    if ShowSelfHealth then
        local char = LocalPlayer.Character
        if char then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                local health = math.floor(humanoid.Health)
                local maxHealth = math.floor(humanoid.MaxHealth)
                SelfHealthText.Text = string.format("HP: %d/%d", health, maxHealth)
                
                local healthPercent = maxHealth > 0 and health / maxHealth or 0
                if healthPercent > 0.6 then
                    SelfHealthText.Color = Color3.fromRGB(0, 255, 0)
                elseif healthPercent > 0.3 then
                    SelfHealthText.Color = Color3.fromRGB(255, 255, 0)
                else
                    SelfHealthText.Color = Color3.fromRGB(255, 0, 0)
                end
            else
                SelfHealthText.Text = "HP: N/A"
            end
        else
            SelfHealthText.Text = "HP: N/A"
        end
    end
    
    updateEsp()
end)

Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
    if SelfHealthText then
        SelfHealthText.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2 + 50)
    end
end)

