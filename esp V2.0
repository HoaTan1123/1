local espCache = {}

local Bones = {
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},
    {"LowerTorso", "LeftUpperLeg"}, {"LowerTorso", "RightUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"}, {"RightUpperLeg", "RightLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"}, {"RightLowerLeg", "RightFoot"},
    {"UpperTorso", "LeftUpperArm"}, {"UpperTorso", "RightUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"}, {"RightUpperArm", "RightLowerArm"},
    {"LeftLowerArm", "LeftHand"}, {"RightLowerArm", "RightHand"}
}

local function IsFriend(plr)
    if not FriendESPEnabled then return false end
    if plr == LocalPlayer then return false end
    local success, result = pcall(function()
        return plr:IsFriendsWith(LocalPlayer.UserId)
    end)
    if success and result then
        return true
    end
    return false
end

local function IsTeammate(plr)
    if not ESP_SETTINGS.TeamCheck then
        return false
    end
    if plr == LocalPlayer then
        return true
    end
    if LocalPlayer.Team and plr.Team then
        return plr.Team == LocalPlayer.Team
    end
    return false
end

local function GetPlayerColor(plr)
    if IsFriend(plr) then
        if IsTeammate(plr) then
            return FriendTeamColor
        else
            return FriendEnemyColor
        end
    end
    if ESP_SETTINGS.TeamCheck and IsTeammate(plr) then
        return Color3.fromRGB(0, 255, 0)
    else
        if ESP_SETTINGS.WallCheck then
            return ESP_SETTINGS.BoxColor
        else
            return Color3.fromRGB(255, 0, 0)
        end
    end
end

local function isPlayerBehindWall(player)
    local character = player.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    local head = character:FindFirstChild("Head")
    local targetPart = head or rootPart
    if not targetPart then return false end
    
    local origin = Camera.CFrame.Position
    local target = targetPart.Position
    local direction = (target - origin).Unit
    local distance = (target - origin).Magnitude
    
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, character}
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.IgnoreWater = true
    
    local rayResult = Workspace:Raycast(origin, direction * distance, rayParams)
    if rayResult then
        local hitPart = rayResult.Instance
        if hitPart then
            local hitCharacter = hitPart:FindFirstAncestorOfClass("Model")
            return hitCharacter and hitCharacter ~= character
        end
    end
    return false
end

local function createDrawing(class, properties)
    local drawing = Drawing.new(class)
    for property, value in pairs(properties) do
        drawing[property] = value
    end
    return drawing
end

local function createEsp(player)
    local esp = {
        tracer = createDrawing("Line", {
            Thickness = ESP_SETTINGS.TracerThickness,
            Color = ESP_SETTINGS.TracerColor,
            Transparency = 0.5,
            Visible = false
        }),
        box = createDrawing("Square", {
            Color = ESP_SETTINGS.BoxColor,
            Thickness = 1,
            Filled = false,
            Visible = false
        }),
        name = createDrawing("Text", {
            Color = ESP_SETTINGS.NameColor,
            Outline = true,
            Center = true,
            Size = 13,
            Visible = false
        }),
        health = createDrawing("Line", {
            Thickness = ESP_SETTINGS.HealthBarWidth,
            Visible = false
        }),
        healthBg = createDrawing("Line", {
            Thickness = ESP_SETTINGS.HealthBarWidth,
            Color = Color3.fromRGB(40, 40, 40),
            Visible = false
        }),
        distance = createDrawing("Text", {
            Color = Color3.new(1, 1, 1),
            Size = 12,
            Outline = true,
            Center = true,
            Visible = false
        }),
        skeleton = {},
        highlight = nil
    }
    
    for i = 1, #Bones do
        local line = createDrawing("Line", {
            Thickness = 1,
            Color = ESP_SETTINGS.SkeletonColor,
            Visible = false
        })
        table.insert(esp.skeleton, line)
    end
    
    espCache[player] = esp
end

local function removeEsp(player)
    local esp = espCache[player]
    if not esp then return end
    
    if esp.tracer then esp.tracer:Remove() end
    if esp.box then esp.box:Remove() end
    if esp.name then esp.name:Remove() end
    if esp.health then esp.health:Remove() end
    if esp.healthBg then esp.healthBg:Remove() end
    if esp.distance then esp.distance:Remove() end
    for _, line in ipairs(esp.skeleton) do
        if line then line:Remove() end
    end
    if esp.highlight then esp.highlight:Destroy() end
    
    espCache[player] = nil
end

local function updateEsp()
    for player, esp in pairs(espCache) do
        local character = player.Character
        local isTeammate = IsTeammate(player)
        
        if isTeammate and not ESP_SETTINGS.TeamCheck then
            esp.tracer.Visible = false
            esp.box.Visible = false
            esp.name.Visible = false
            esp.health.Visible = false
            esp.healthBg.Visible = false
            esp.distance.Visible = false
            for _, line in ipairs(esp.skeleton) do
                line.Visible = false
            end
            if esp.highlight then esp.highlight.Enabled = false end
        else
            if character then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                local head = character:FindFirstChild("Head")
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                
                local isBehindWall = ESP_SETTINGS.WallCheck and isPlayerBehindWall(player)
                local shouldShow = not isBehindWall and ESP_SETTINGS.Enabled
                
                if rootPart and head and humanoid and shouldShow and humanoid.Health > 0 then
                    local hrp2D, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                    
                    if onScreen then
                        local topPoint = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                        local bottomPoint = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 2.5, 0))
                        local charHeight = math.abs(topPoint.Y - bottomPoint.Y)
                        
                        local boxSize = Vector2.new(math.floor(charHeight * 0.55), math.floor(charHeight))
                        local boxPosition = Vector2.new(math.floor(hrp2D.X - boxSize.X / 2), math.floor(topPoint.Y))
                        
                        boxSize = Vector2.new(math.clamp(boxSize.X, 15, 150), math.clamp(boxSize.Y, 30, 250))
                        boxPosition = Vector2.new(
                            math.clamp(boxPosition.X, 5, Camera.ViewportSize.X - boxSize.X - 5),
                            math.clamp(boxPosition.Y, 5, Camera.ViewportSize.Y - boxSize.Y - 5)
                        )
                        
                        local playerColor = GetPlayerColor(player)
                        
                        if ESP_SETTINGS.WallCheck and isBehindWall then
                            playerColor = Color3.fromRGB(255, 255, 0)
                        end
                        
                        if ESP_SETTINGS.ShowBox then
                            esp.box.Size = boxSize
                            esp.box.Position = boxPosition
                            esp.box.Color = playerColor
                            esp.box.Visible = true
                        else
                            esp.box.Visible = false
                        end
                        
                        if ESP_SETTINGS.ShowHealth and humanoid then
                            local healthPercent = humanoid.Health / humanoid.MaxHealth
                            local healthHeight = boxSize.Y * healthPercent
                            local barX = boxPosition.X - ESP_SETTINGS.HealthBarWidth - 2
                            
                            if barX < 5 then
                                barX = boxPosition.X + boxSize.X + 2
                            end
                            
                            local barY = boxPosition.Y
                            
                            local healthColor
                            if healthPercent > 0.6 then
                                healthColor = Color3.fromRGB(0, 255, 0)
                            elseif healthPercent > 0.3 then
                                healthColor = Color3.fromRGB(255, 255, 0)
                            else
                                healthColor = Color3.fromRGB(255, 0, 0)
                            end
                            
                            esp.healthBg.From = Vector2.new(barX, barY)
                            esp.healthBg.To = Vector2.new(barX, barY + boxSize.Y)
                            esp.healthBg.Thickness = ESP_SETTINGS.HealthBarWidth
                            esp.healthBg.Visible = true
                            
                            if healthHeight > 0 then
                                esp.health.From = Vector2.new(barX, barY + boxSize.Y - healthHeight)
                                esp.health.To = Vector2.new(barX, barY + boxSize.Y)
                                esp.health.Color = healthColor
                                esp.health.Thickness = ESP_SETTINGS.HealthBarWidth
                                esp.health.Visible = true
                            else
                                esp.health.Visible = false
                            end
                        else
                            esp.health.Visible = false
                            esp.healthBg.Visible = false
                        end
                        
                        if ESP_SETTINGS.ShowTracer then
                            local tracerY
                            if ESP_SETTINGS.TracerPosition == "Top" then
                                tracerY = 0
                            elseif ESP_SETTINGS.TracerPosition == "Middle" then
                                tracerY = Camera.ViewportSize.Y / 2
                            else
                                tracerY = Camera.ViewportSize.Y
                            end
                            esp.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, tracerY)
                            esp.tracer.To = Vector2.new(hrp2D.X, hrp2D.Y)
                            esp.tracer.Color = playerColor
                            esp.tracer.Visible = true
                        else
                            esp.tracer.Visible = false
                        end
                        
                        if ESP_SETTINGS.ShowName then
                            esp.name.Text = player.Name
                            esp.name.Position = Vector2.new(boxPosition.X + boxSize.X / 2, boxPosition.Y - 16)
                            esp.name.Color = playerColor
                            esp.name.Visible = true
                        else
                            esp.name.Visible = false
                        end
                        
                        if ESP_SETTINGS.ShowDistance then
                            local distance = (Camera.CFrame.Position - rootPart.Position).Magnitude
                            esp.distance.Text = string.format("%.1fm", distance)
                            esp.distance.Position = Vector2.new(boxPosition.X + boxSize.X / 2, boxPosition.Y + boxSize.Y + 12)
                            esp.distance.Visible = true
                        else
                            esp.distance.Visible = false
                        end
                        
                        if ESP_SETTINGS.ShowSkeleton then
                            for i, bonePair in ipairs(Bones) do
                                local p1 = character:FindFirstChild(bonePair[1])
                                local p2 = character:FindFirstChild(bonePair[2])
                                if p1 and p2 then
                                    local pos1, vis1 = Camera:WorldToViewportPoint(p1.Position)
                                    local pos2, vis2 = Camera:WorldToViewportPoint(p2.Position)
                                    if vis1 and vis2 and esp.skeleton[i] then
                                        esp.skeleton[i].From = Vector2.new(pos1.X, pos1.Y)
                                        esp.skeleton[i].To = Vector2.new(pos2.X, pos2.Y)
                                        esp.skeleton[i].Color = playerColor
                                        esp.skeleton[i].Visible = true
                                    else
                                        esp.skeleton[i].Visible = false
                                    end
                                else
                                    if esp.skeleton[i] then
                                        esp.skeleton[i].Visible = false
                                    end
                                end
                            end
                        else
                            for _, line in ipairs(esp.skeleton) do
                                line.Visible = false
                            end
                        end
                        
                        if ESP_SETTINGS.ShowHighlight then
                            if not esp.highlight then
                                esp.highlight = Instance.new("Highlight")
                                esp.highlight.FillTransparency = 0.6
                                esp.highlight.OutlineTransparency = 0.3
                            end
                            esp.highlight.Parent = character
                            esp.highlight.FillColor = playerColor
                            if IsFriend(player) then
                                if isTeammate then
                                    esp.highlight.OutlineColor = Color3.fromRGB(0, 50, 255)
                                else
                                    esp.highlight.OutlineColor = Color3.fromRGB(200, 100, 0)
                                end
                            elseif isTeammate then
                                esp.highlight.OutlineColor = Color3.fromRGB(0, 180, 0)
                            else
                                if ESP_SETTINGS.WallCheck and isBehindWall then
                                    esp.highlight.OutlineColor = Color3.fromRGB(180, 180, 0)
                                else
                                    esp.highlight.OutlineColor = Color3.fromRGB(180, 0, 0)
                                end
                            end
                            esp.highlight.Enabled = true
                        else
                            if esp.highlight then
                                esp.highlight.Enabled = false
                            end
                        end
                    else
                        esp.tracer.Visible = false
                        esp.box.Visible = false
                        esp.name.Visible = false
                        esp.health.Visible = false
                        esp.healthBg.Visible = false
                        esp.distance.Visible = false
                        for _, line in ipairs(esp.skeleton) do
                            line.Visible = false
                        end
                        if esp.highlight then
                            esp.highlight.Enabled = false
                        end
                    end
                else
                    esp.tracer.Visible = false
                    esp.box.Visible = false
                    esp.name.Visible = false
                    esp.health.Visible = false
                    esp.healthBg.Visible = false
                    esp.distance.Visible = false
                    for _, line in ipairs(esp.skeleton) do
                        line.Visible = false
                    end
                    if esp.highlight then
                        esp.highlight.Enabled = false
                    end
                end
            else
                esp.tracer.Visible = false
                esp.box.Visible = false
                esp.name.Visible = false
                esp.health.Visible = false
                esp.healthBg.Visible = false
                esp.distance.Visible = false
                for _, line in ipairs(esp.skeleton) do
                    line.Visible = false
                end
                if esp.highlight then
                    esp.highlight.Enabled = false
                end
            end
        end
    end
end

